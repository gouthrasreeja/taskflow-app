# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Secret used to sign JSON Web Tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# How long issued tokens stay valid
JWT_EXPIRES_IN=7d

# Port the Express server listens on
PORT=5000

# Comma-separated list of allowed front-end origins for CORS
CLIENT_ORIGIN=http://localhost:5173
