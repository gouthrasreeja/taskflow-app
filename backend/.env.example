# Copy to .env for local development. In production set these in the host's dashboard instead
# (never commit real values).

NODE_ENV=development            # set to "production" on the server

# MongoDB connection string (local, or Atlas: mongodb+srv://user:password@cluster.mongodb.net/taskflow)
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Secret that signs login tokens. Production requires 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

PORT=5000

# Allowed front-end origin(s), comma-separated, scheme + host only (no trailing slash).
# REQUIRED in production; the app refuses to start without it.
CLIENT_ORIGIN=http://localhost:5173

# Optional tuning
LOG_LEVEL=info                  # error | warn | info | debug
AUTH_RATE_LIMIT_MAX=20          # login/signup attempts per IP per 15 minutes
